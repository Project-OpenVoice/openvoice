# Laya Decision Engine
# Laya is `pip install laya` — NOT an Ollama model.
# MODEL_DECISION refers to the Laya checkpoint name.
MODEL_DECISION=laya

# Memory paths
VAULT_PATH=./data/vault
SQLITE_PATH=./data/sqlite/openvoice.db
CHROMA_PATH=./data/chroma

# Embedding model (sentence-transformers — fully local, no server needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Phase 1 only — unused in PRE-PHASE-0
OLLAMA_HOST=http://localhost:11434
MODEL_CHAT=qwen3:8b

# Cloud (always disabled in PRE-PHASE-0)
CLOUD_ENABLED=false
